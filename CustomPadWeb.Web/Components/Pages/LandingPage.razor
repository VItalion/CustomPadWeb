@page "/"
@using CustomPadWeb.Web.Components.Layout

@inject IJSRuntime jsRuntime

@layout MainLayout

<script src="scripts/slideshow.js"></script>

<div class="grid place-items-center px-4">

    <!-- Hero Section -->
    <section class="container mx-auto max-w-5xl py-20 grid grid-cols-1 md:grid-cols-2 gap-16 items-center header-container">

        <div class="text-center md:text-left text-white">
            <h1 class="text-4xl md:text-6xl font-bold mb-6">
                Create Your Perfect Custom Gamepad
            </h1>

            <p class="text-lg md:text-xl text-slate-300 mb-10">
                Build the controller that matches your style and boosts your gameplay.
                Choose colors, materials, buttons, sticks, and more — all in an intuitive configurator.
            </p>

            <a href="/configurator"
               class="px-8 py-4 bg-blue-600 hover:bg-blue-700 rounded-2xl text-xl font-semibold transition-all shadow-lg shadow-blue-600/40">
                Start Configuring
            </a>
        </div>

        <div class="flex justify-center">
            <img src="images/hero_gamepad.png"
                 alt="Custom Gamepad"
                 class="w-full max-w-md rounded-2xl shadow-xl max-width-200px" />
        </div>

    </section>

    <!-- Features Section -->
    <section class="container mx-auto max-w-5xl py-20">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center container-3-column">

            <div class="p-8 border rounded-2xl shadow-sm hover:shadow-md transition-all bg-white text-slate-900">
                <img src="images/icons/color.svg" class="w-16 mx-auto mb-6 icon" />
                <h3 class="text-2xl font-semibold mb-4">Endless Customization</h3>
                <p class="text-slate-600">
                    Sticks, buttons, panels, materials, LEDs, textures — everything is customizable.
                </p>
            </div>

            <div class="p-8 border rounded-2xl shadow-sm hover:shadow-md transition-all bg-white text-slate-900">
                <img src="images/icons/performance.svg" class="w-16 mx-auto mb-6 icon" />
                <h3 class="text-2xl font-semibold mb-4">Pro-Level Performance</h3>
                <p class="text-slate-600">
                    High-quality components designed for competitive gaming and long durability.
                </p>
            </div>

            <div class="p-8 border rounded-2xl shadow-sm hover:shadow-md transition-all bg-white text-slate-900">
                <img src="images/icons/delivery.svg" class="w-16 mx-auto mb-6 icon" />
                <h3 class="text-2xl font-semibold mb-4">Fast Worldwide Shipping</h3>
                <p class="text-slate-600">
                    Once your design is approved, we assemble and ship your custom gamepad quickly.
                </p>
            </div>

        </div>
    </section>

    <!-- Showcase Section -->
    <section class="container mx-auto max-w-5xl py-20 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-white">Popular Designs</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 slideshow-container">

            <div class="slide-container">
                <div class="slide">
                    <img src="images/mockups/galaxy_mockup.png" class="rounded-2xl shadow-lg mockup" />
                    <h4 class="font-semibold text-xl text-white mt-4">Galaxy Edition</h4>
                </div>

                <div class="slide">
                    <img src="images/mockups/neon_mockup.png" class="rounded-2xl shadow-lg mockup" />
                    <h4 class="font-semibold text-xl text-white mt-4">Cyber Neon</h4>
                </div>

                <div class="slide">
                    <img src="images/mockups/steals_mockup.png" class="rounded-2xl shadow-lg mockup" />
                    <h4 class="font-semibold text-xl text-white mt-4">Stealth Matte</h4>
                </div>
            </div>

            <button class="prev" onclick="plusSlides(-1)">&#10094;</button>
            <button class="next" onclick="plusSlides(1)">&#10095;</button>

            <div class="w-full text-center mt-4">
                <span class="dot" onclick="currentSlide(1)"></span>
                <span class="dot" onclick="currentSlide(2)"></span>
                <span class="dot" onclick="currentSlide(3)"></span>
            </div>

        </div>
    </section>

    <!-- CTA -->
    <section class="container mx-auto max-w-5xl py-20 text-center text-white">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Ready to Craft Your Dream Gamepad?</h2>

        <p class="text-xl text-slate-300 mb-10">
            Join thousands of gamers already playing with fully customized controllers.
        </p>

        <a href="/configurator"
           class="px-10 py-4 bg-blue-600 hover:bg-blue-700 rounded-2xl text-xl font-semibold transition-all shadow-lg shadow-blue-600/30">
            Launch Configurator
        </a>
    </section>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        showSlides(1);
    });
</script>
