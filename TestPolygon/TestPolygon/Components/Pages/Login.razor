@page "/login"
@rendermode InteractiveWebAssembly
@using CustomPadWeb.TestPolygon.Clients
@using CustomPadWeb.TestPolygon.Models
@using Microsoft.AspNetCore.Components.Forms
@inject CustomPadWeb.TestPolygon.Clients.AuthApiClient AuthApi
@inject CustomPadWeb.TestPolygon.Providers.JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="login-page">
    <div class="login-card">

        <h2>Login</h2>

        <h2>Render mode: @renderModeLabel</h2>
        <h3>Is interactive: @isInteractive</h3>

        <EditForm Model="LoginModel" OnValidSubmit="DoLogin" FormName="LoginForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="LoginModel.Email" class="form-input" placeholder="Email" />
            </div>

            <div class="form-group password-group">
                <label>Password</label>

                <div class="password-container">
                    <InputText @bind-Value="LoginModel.Password" class="form-input" placeholder="Password" type="password" />
                </div>
            </div>


            <button type="submit" class="login-btn" disabled="@isBusy">
                @(isBusy ? "Logging in..." : "Login")
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p style="color:red; text-align:center; margin-top:10px;">
                @errorMessage
            </p>
        }

        <div class="register-link">
            <p>Don’t have an account?
                <a href="/register">Register</a>
            </p>
        </div>
    </div>
</div>


@code {
    [SupplyParameterFromForm(FormName = "LoginForm")]
    LoginModel LoginModel { get; set; } = new();

    string? errorMessage;
    bool isBusy;
    private bool _show = false;

    string renderModeLabel = string.Empty;
    bool isInteractive = false;

    override protected void OnInitialized()
    {
        renderModeLabel = RendererInfo.Name;
        isInteractive = RendererInfo.IsInteractive;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        renderModeLabel = RendererInfo.Name;
        isInteractive = RendererInfo.IsInteractive;
    }

    private async Task DoLogin()
    {
        isBusy = true;
        errorMessage = null;

        renderModeLabel = RendererInfo.Name;
        isInteractive = RendererInfo.IsInteractive;

        try
        {
            var result = await AuthApi.LoginAsync(new LoginRequest(LoginModel.Email, LoginModel.Password));
            
            renderModeLabel = RendererInfo.Name;
            isInteractive = RendererInfo.IsInteractive;
            
            await AuthStateProvider.SignInAsync(result.AccessToken, result.RefreshToken);

            renderModeLabel = RendererInfo.Name;
            isInteractive = RendererInfo.IsInteractive;
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

        renderModeLabel = RendererInfo.Name;
        isInteractive = RendererInfo.IsInteractive;

        isBusy = false;
    }

    private void Toggle()
    {
        _show = !_show;
    }
}