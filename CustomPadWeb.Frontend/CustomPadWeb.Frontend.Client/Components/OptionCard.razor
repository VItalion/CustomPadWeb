@using Microsoft.AspNetCore.Components

<div class="card option-card @(IsSelected ? "selected" : "")"
     @onclick="OnSelectClicked" @ref="_rootRef">
    <img src="@ImageUrl" class="card-img-top" alt="option" />
    <div class="card-body p-2 text-center">
        <div>@Name</div>
        <button class="btn btn-sm btn-light" @onclick:stopPropagation="true" @onclick="ToggleInfo">?</button>
    </div>

    @* Popover is handled by Bootstrap JS via popoverManager.toggle *@
</div>

<style>
    .option-card { width:120px; position:relative; cursor:pointer; border:1px solid #e9ecef; }
    .option-card img { height:100px; width:100px; object-fit:cover; margin:auto; padding-top:8px; }
    .option-card.selected { border:2px solid #0d6efd; }
    
</style>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;
    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public string ImageUrl { get; set; } = string.Empty;
    [Parameter]
    public bool IsSelected { get; set; } = false;
    [Parameter]
    public EventCallback OnSelected { get; set; }

    private ElementReference _rootRef;

    private Task OnSelectClicked() => OnSelected.InvokeAsync();

    private async Task ToggleInfo()
    {
        // Use global popover manager to ensure only one is visible
        await JS.InvokeVoidAsync("popoverManager.toggle", _rootRef, Name, Description);
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}
